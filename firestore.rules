rules_version = '2';

// Reglas de seguridad de la Pastoral Juvenil Ágape.
// Pégalas en Firebase → Firestore Database → Reglas → Publicar.
// El correo de bootstrapAdmin() es el primer administrador (el mismo de bootstrapAdmins en js/config.js).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function bootstrapAdmin() { return signedIn() && myEmail() in ['iperezconus84@gmail.com']; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().active == true;
    }
    function isAdmin() { return isMember() && me().role == 'admin'; }
    // Equipo: administradores y coordinadores (Agenda, Portada y moderación de muro y chat).
    function isStaff() { return isMember() && me().role in ['admin', 'coordinador']; }
    // Guías: quienes acompañan a los jóvenes (equipo y dirigentes).
    function isGuide() { return isMember() && me().role in ['admin', 'coordinador', 'dirigente']; }
    function validRole(r) { return r in ['admin', 'coordinador', 'dirigente', 'aspirante', 'ingreso', 'madurez']; }
    // Cuentas protegidas: siempre administradoras y activas.
    function protectedEmail(e) { return e in ['iperezconus84@gmail.com']; }

    // Contenido del curso publicado desde Gestión: lo lee cualquiera, lo escribe un administrador.
    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Portada de Inicio: también la editan los coordinadores.
    match /content/portada {
      allow write: if isStaff();
    }
    // Cuadro de honor y desafío de la semana: los publica el equipo. Cumpleaños: los actualizan los guías.
    match /content/honor { allow write: if isStaff(); }
    match /content/desafio { allow write: if isStaff(); }
    match /content/cumples { allow write: if isGuide(); }
    // Datos que no deben ser públicos (cumpleaños): solo cuentas activas; los actualizan los guías.
    match /privado/{docId} {
      allow read: if isMember();
      allow write: if isGuide();
    }
    // Página para familias: la editan administradores y coordinadores.
    match /content/familias { allow write: if isStaff(); }

    // Invitaciones: el documento se llama como el correo invitado (en minúsculas).
    match /invites/{email} {
      allow get: if signedIn() && myEmail() == email;
      allow read, delete: if isAdmin();
      // Jóvenes: no se puede invitar sin registrar el consentimiento de su familia (o que es mayor de edad).
      allow create, update: if isAdmin() && validRole(request.resource.data.role)
        && (!(request.resource.data.role in ['ingreso', 'madurez', 'aspirante'])
            || (request.resource.data.consent is map
                && (request.resource.data.consent.get('mayor', false) == true || request.resource.data.consent.get('fecha', '') is string && request.resource.data.consent.get('fecha', '').size() == 10)));
    }

    // Cuentas. Cada persona crea la suya al entrar por primera vez, solo si fue invitada
    // (con el rol de la invitación) o si es administrador inicial.
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      // Administradores: todo. Coordinadores: directorio para armar salas (el avance sigue siendo solo de administradores).
      allow read: if isStaff();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == myEmail()
        && request.resource.data.active == true
        && (
          (exists(/databases/$(database)/documents/invites/$(myEmail()))
            && request.resource.data.role == get(/databases/$(database)/documents/invites/$(myEmail())).data.role)
          || (bootstrapAdmin() && request.resource.data.role == 'admin')
        );
      // Cada uno puede actualizar su nombre, parroquia y última conexión; nunca su rol ni su estado.
      allow update: if (isMember() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'parish', 'lastSeen', 'avatar'])
          && (!('avatar' in request.resource.data) || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 20)))
        || (isAdmin() && validRole(request.resource.data.role)
            && (!protectedEmail(resource.data.email) || (request.resource.data.role == 'admin' && request.resource.data.active == true)));
      allow delete: if isAdmin() && !protectedEmail(resource.data.email);
    }

    // Avance en los cursos: lo escribe su dueño; lo leen su dueño y los administradores.
    match /progress/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if isMember() && request.auth.uid == uid;
    }

    // Cuaderno personal: privado, solo su dueño (ni siquiera los administradores lo leen).
    match /notes/{uid} {
      allow read, write: if isMember() && request.auth.uid == uid;
    }

    // Constancias: cualquiera puede verificar un código; solo el dueño la registra; un administrador puede anularla.
    match /certificates/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isMember() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Muro de la comunidad. Lo visible lo lee cualquiera; escriben los usuarios invitados;
    // los administradores publican anuncios y temas, fijan, cierran, ocultan y borran.
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyMyKey(field) {
      return request.resource.data[field] is map
        && request.resource.data[field].diff(resource.data[field]).affectedKeys().hasOnly([request.auth.uid]);
    }
    function markUpdate() {
      return (changed().hasOnly(['likes']) && onlyMyKey('likes'))
        || (changed().hasOnly(['reports']) && onlyMyKey('reports'));
    }
    function asAuthor(d) {
      return d.authorUid == request.auth.uid && d.authorRole == me().role
        && d.authorName is string && d.authorName.size() > 0 && d.authorName.size() <= 60
        && d.hidden == false && d.likes.size() == 0 && d.reports.size() == 0 && d.createdAt == request.time;
    }
    function validText(t, max) { return t is string && t.size() > 0 && t.size() <= max; }

    // El muro lo leen solo quienes tienen cuenta (los jóvenes escriben ahí).
    match /wall/{postId} {
      allow read: if isMember() && (resource.data.hidden == false || isStaff());
      allow create: if isMember() && asAuthor(request.resource.data)
        && validText(request.resource.data.title, 140) && request.resource.data.body is string && request.resource.data.body.size() <= 4000
        && request.resource.data.type in ['anuncio', 'tema', 'pregunta', 'logro', 'encuesta']
        && (request.resource.data.type != 'encuesta' || (request.resource.data.options is list
            && request.resource.data.options.size() >= 2 && request.resource.data.options.size() <= 6 && request.resource.data.votes.size() == 0))
        && (isStaff() || (request.resource.data.type == 'pregunta' && request.resource.data.pinned == false)
          // Felicitación automática: solo por una constancia propia, una por constancia.
          || (request.resource.data.type == 'logro' && request.resource.data.pinned == false
              && request.resource.data.certCode is string && postId == 'logro-' + request.resource.data.certCode
              && get(/databases/$(database)/documents/certificates/$(request.resource.data.certCode)).data.uid == request.auth.uid))
        && request.resource.data.closed == false && request.resource.data.replyCount == 0
        && request.resource.data.lastActivity == request.time;
      allow update: if isStaff()
        || (isMember() && resource.data.hidden == false && (
          markUpdate()
          // votar en una encuesta: cada uno su propio voto, mientras esté abierta
          || (resource.data.type == 'encuesta' && resource.data.closed == false && changed().hasOnly(['votes'])
              && request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([request.auth.uid])
              && (!(request.auth.uid in request.resource.data.votes)
                  || (request.resource.data.votes[request.auth.uid] is int && request.resource.data.votes[request.auth.uid] >= 0
                      && request.resource.data.votes[request.auth.uid] < resource.data.options.size())))
          // al responder o borrar una respuesta se actualiza el contador
          || (changed().hasOnly(['replyCount', 'lastActivity'])
              && (request.resource.data.replyCount - resource.data.replyCount) in [1, -1]
              && (request.resource.data.lastActivity == resource.data.lastActivity || request.resource.data.lastActivity == request.time))
          || (resource.data.authorUid == request.auth.uid && changed().hasOnly(['title', 'body', 'editedAt'])
              && validText(request.resource.data.title, 140) && request.resource.data.body.size() <= 4000)
        ));
      allow delete: if isStaff() || (isMember() && resource.data.authorUid == request.auth.uid);

      match /replies/{replyId} {
        function post() { return get(/databases/$(database)/documents/wall/$(postId)).data; }
        allow read: if isMember() && ((resource.data.hidden == false && post().hidden == false) || isStaff());
        allow create: if isMember() && asAuthor(request.resource.data) && validText(request.resource.data.body, 2000)
          && post().hidden == false && post().closed == false && post().type != 'anuncio';
        allow update: if isStaff()
          || (isMember() && resource.data.hidden == false && (
            markUpdate()
            || (resource.data.authorUid == request.auth.uid && changed().hasOnly(['body', 'editedAt'])
                && validText(request.resource.data.body, 2000))
          ));
        // la borra su autor, un administrador o el autor del tema (al borrar su tema completo)
        allow delete: if isStaff() || (isMember() && (resource.data.authorUid == request.auth.uid || post().authorUid == request.auth.uid));
      }
    }


    // Chat por salas: todas grupales. Leen y escriben solo los integrantes de cada sala.
    // Cuatro salas fijas (la general es de todos) y las que crea el equipo en «salas».
    // Administradores y coordinadores están en todas y moderan.
    function builtIn(sala) { return sala in ['general', 'coordinacion', 'dirigentes', 'aspirantes']; }
    function salaDoc(sala) { return get(/databases/$(database)/documents/salas/$(sala)).data; }
    function inCustom(sala) {
      return exists(/databases/$(database)/documents/salas/$(sala)) && (isStaff()
        || salaDoc(sala).access == 'all'
        || (salaDoc(sala).access == 'roles' && me().role in salaDoc(sala).roles)
        || (salaDoc(sala).access == 'people' && request.auth.uid in salaDoc(sala).members));
    }
    function inSala(sala) {
      return isMember() && (builtIn(sala)
        ? (sala == 'general' || isStaff() || sala in me().get('salas', me().role == 'aspirante' ? ['aspirantes'] : (me().role in ['ingreso', 'madurez'] ? [] : ['dirigentes'])))
        : inCustom(sala));
    }
    function openSala(sala) { return builtIn(sala) || salaDoc(sala).get('archived', false) != true; }

    // Salas creadas por el equipo: las ven quienes tienen cuenta; las crean y editan administradores y coordinadores.
    match /salas/{salaId} {
      allow read: if isMember();
      allow create, update: if isStaff() && !builtIn(salaId)
        && validText(request.resource.data.name, 60)
        && request.resource.data.access in ['all', 'roles', 'people']
        && request.resource.data.roles is list && request.resource.data.members is list
        && (request.resource.data.access != 'roles' || request.resource.data.roles.size() > 0)
        && (request.resource.data.access != 'people' || request.resource.data.members.size() >= 3);
      allow delete: if isStaff();
    }
    match /chat/{sala}/msgs/{msgId} {
      allow read: if inSala(sala);
      allow create: if inSala(sala) && openSala(sala)
        && request.resource.data.authorUid == request.auth.uid && request.resource.data.authorRole == me().role
        && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 60
        && validText(request.resource.data.text, 1500)
        && request.resource.data.reports.size() == 0 && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['text', 'authorUid', 'authorName', 'authorRole', 'authorAvatar', 'reports', 'reactions', 'replyTo', 'kind', 'buzzTo', 'buzzToName', 'createdAt'])
        && (!('authorAvatar' in request.resource.data) || (request.resource.data.authorAvatar is string && request.resource.data.authorAvatar.size() <= 20))
        && (!('reactions' in request.resource.data) || request.resource.data.reactions.size() == 0)
        && (!('replyTo' in request.resource.data) || (request.resource.data.replyTo is map && request.resource.data.replyTo.keys().hasOnly(['id', 'name', 'text'])))
        && (!('kind' in request.resource.data) || (request.resource.data.kind == 'buzz' && request.resource.data.buzzTo is string));
      // Reportar o reaccionar: cada uno cambia solo su propia marca.
      allow update: if inSala(sala) && (
        (changed().hasOnly(['reports']) && onlyMyKey('reports'))
        || (changed().hasOnly(['reactions']) && request.resource.data.reactions is map
            && ('reactions' in resource.data
                ? request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid])
                : request.resource.data.reactions.keys().hasOnly([request.auth.uid]))
            && (!(request.auth.uid in request.resource.data.reactions)
                || request.resource.data.reactions[request.auth.uid] in ['❤️', '🙏', '😂', '👍', '😮', '🔥'])));
      allow delete: if isStaff() || (inSala(sala) && resource.data.authorUid == request.auth.uid);
    }


    // Velas de la capilla: intenciones que solo ve la comunidad con cuenta.
    // Cada uno enciende la suya; todos pueden marcar «rezo por esto»; la apaga su autor o el equipo.
    match /velas/{velaId} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['text', 'authorUid', 'authorName', 'prays', 'createdAt'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 1500
        && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 60
        && request.resource.data.prays.size() == 0 && request.resource.data.createdAt == request.time;
      allow update: if isMember() && changed().hasOnly(['prays']) && onlyMyKey('prays');
      allow delete: if isStaff() || (isMember() && resource.data.authorUid == request.auth.uid);
    }

    // Cancionero: lo ve la comunidad con cuenta (uso interno). Lo editan el equipo y quienes un
    // administrador habilita para el apostolado del cancionero (users.cantor); borrar es solo del equipo.
    function canSongs() { return isStaff() || (isMember() && me().get('cantor', false) == true); }
    match /canciones/{songId} {
      allow read: if isMember();
      allow create, update: if canSongs() && validText(request.resource.data.title, 120)
        && request.resource.data.body is string && request.resource.data.body.size() <= 20000;
      allow delete: if isStaff();
    }
    match /repertorios/{repId} {
      allow read: if isMember();
      allow create, update: if canSongs() && validText(request.resource.data.name, 120);
      allow delete: if isStaff();
    }

    // Quién está en línea en cada sala (cada uno escribe solo su propia presencia).
    match /chat/{sala}/presence/{uid} {
      allow read: if inSala(sala);
      allow create, update: if inSala(sala)
        && uid == request.auth.uid && request.resource.data.at == request.time
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'role', 'at']);
      allow delete: if (signedIn() && uid == request.auth.uid) || isStaff();
    }

    // Banco de dinámicas: lo ve la comunidad con cuenta; lo alimentan los guías.
    match /dinamicas/{id} {
      allow read: if isMember();
      allow create, update: if isGuide() && validText(request.resource.data.title, 80)
        && request.resource.data.pasos is string && request.resource.data.pasos.size() <= 4000;
      allow delete: if isStaff() || (isGuide() && resource.data.authorUid == request.auth.uid);
    }

    // Acompañamiento: lista de jóvenes y asistencia. Solo los guías; cada joven con cuenta ve su pasaporte
    // y puede cambiar su lema, el color de portada y su avatar. Vincular cuentas es del equipo.
    match /jovenes/{id} {
      allow read: if isGuide() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isGuide() && validText(request.resource.data.nombre, 80)
        && request.resource.data.etapa in ['ingreso', 'madurez', 'aspirante', 'equipo']
        && (isStaff() || request.resource.data.get('uid', '') == '');
      allow update: if (isGuide() && validText(request.resource.data.nombre, 80)
          && request.resource.data.etapa in ['ingreso', 'madurez', 'aspirante', 'equipo']
          && (isStaff() || request.resource.data.get('uid', '') == resource.data.get('uid', ''))
          && (isStaff() || !changed().hasAny(['guia', 'guia2', 'guiaNombre', 'guia2Nombre'])))
        || (signedIn() && resource.data.uid == request.auth.uid && changed().hasOnly(['lema', 'portada', 'avatar'])
          && request.resource.data.get('lema', '') is string && request.resource.data.get('lema', '').size() <= 60);
      allow delete: if isStaff();
    }
    match /sesiones/{fecha} {
      allow read, create, update: if isGuide();
      allow delete: if isStaff();
    }

    // Desafío de la semana: cada uno marca que lo cumplió.
    match /desafios/{key}/hechos/{uid} {
      allow read: if isMember();
      allow create, update: if isMember() && uid == request.auth.uid && request.resource.data.keys().hasOnly(['n', 'a', 'at']);
      allow delete: if isMember() && uid == request.auth.uid;
    }

    // Contador de visitas anónimo: una visita por dispositivo y día (v total, c con cuenta, g visitantes).
    // Cualquiera suma 1; solo el equipo lo lee. No guarda datos personales.
    // Rosarios por la intención del Papa: contador público por mes; quienes tienen cuenta suman de a uno.
    match /rosarios/{mes} {
      allow read: if true;
      allow create: if isMember() && mes.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if isMember() && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1;
    }
    match /stats/{day} {
      allow read: if isStaff();
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['v', 'c', 'g'])
        && request.resource.data.get('v', 0) == 1
        && request.resource.data.get('c', 0) + request.resource.data.get('g', 0) == 1;
      allow update: if request.resource.data.keys().hasOnly(['v', 'c', 'g'])
        && request.resource.data.get('v', 0) == resource.data.get('v', 0) + 1
        && request.resource.data.get('c', 0) >= resource.data.get('c', 0)
        && request.resource.data.get('g', 0) >= resource.data.get('g', 0)
        && request.resource.data.get('c', 0) + request.resource.data.get('g', 0) == resource.data.get('c', 0) + resource.data.get('g', 0) + 1;
    }

    // Agenda oficial: la ve cualquiera (familias incluidas); la editan los administradores.
    match /agenda/{eventId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Moderación: los administradores revisan todas las respuestas del muro.
    match /{path=**}/replies/{replyId} {
      allow read: if isStaff();
    }
  }
}
